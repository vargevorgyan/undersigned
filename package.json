{
  "name": "privacy-radar",
  "private": true,
  "workspaces": ["packages/*", "apps/web"],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "seed": "npm run seed -w apps/web",
    "test": "npm test -w packages/core",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "ext:dev": "npm run dev -w apps/extension",
    "ext:build": "npm run build -w apps/extension"
  },
  "engines": { "node": ">=20" }
}
