# AI analysis (without it, a basic keyword analyzer is used)
ANTHROPIC_API_KEY=
# Optional model override (default claude-opus-5-5; claude-haiku-5-5 is ~40x cheaper)
ANALYSIS_MODEL=

# Database: leave empty for zero-setup embedded Postgres in .data/pglite
DATABASE_URL=

APP_URL=http://localhost:3000
CRON_SECRET=

# Email alerts (without it, emails are printed to the console)
SMTP_URL=
EMAIL_FROM=Undersigned <alerts@example.com>

# Billing (without it, "Upgrade" instantly switches plans in dev)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
